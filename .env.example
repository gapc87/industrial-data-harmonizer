# --- CONFIGURACIÓN GENERAL DE LA APLICACIÓN ---
# Opciones: dev (local), test (pytest), prod (producción - JSON logs)
ENV_STATE=dev
PROJECT_NAME="Industrial Data Harmonizer"
API_V1_STR="/api/v1"

# Generar con: just setup-env
# ¡CAMBIAR ESTO EN PRODUCCIÓN!
SECRET_KEY=change_this_secret_key_in_production_999999

# Tiempo de expiración de tokens JWT (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- BASE DE DATOS (POSTGRESQL) ---
# Nota: Si corres la app con 'uv run' (local), usa 'localhost'.
# Si la app corre dentro de Docker, usa el nombre del servicio: 'idh-db'.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=idh_admin
POSTGRES_PASSWORD=change_this_password_in_local_env
POSTGRES_DB=idh_dev

# --- INTEGRACIÓN CON SAP (CIRCUIT BREAKER) ---
# URL base de la API OData/REST de SAP
SAP_API_BASE_URL=https://sandbox.api.sap.com/s4hana
# Tiempo máximo de espera antes de considerar fallo (segundos)
SAP_TIMEOUT_SECONDS=5.0
# Credenciales técnicas (Opcional - dejar vacío si no se usa)
SAP_AUTH_USER=
SAP_AUTH_PASS=

# --- SEGURIDAD Y CORS ---
# Lista de orígenes permitidos separados por coma (para Frontend/Swagger)
BACKEND_CORS_ORIGINS="http://localhost:8000,http://localhost:3000"

# --- CONFIGURACIÓN DE LOGS ---
# Opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- SECURITY SETTINGS ---
JWT_SECRET=change_this_jwt_secret
OAUTH2_CLIENT_ID=change_this_client_id
MTLS_CERT_PATH=./certs/client.crt
